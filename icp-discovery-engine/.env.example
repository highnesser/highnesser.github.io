# --- LLM (required for seed expansion, pain clustering, ICP synthesis) ---
# Google Gemini free tier - no credit card required to sign up.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (gemini-2.5-flash).
GEMINI_MODEL=

# --- Competitor / web search (optional; falls back to a degraded mode without it) ---
# SerpAPI (https://serpapi.com) powers Google search for competitor discovery.
SERPAPI_KEY=

# --- Reddit (optional; unauthenticated public search works without these, but is
# rate-limited and less reliable. Add app credentials for production use.) ---
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=icp-discovery-engine/0.1 by yourusername

# --- Firecrawl (optional; improves landing-page/competitor scraping quality
# beyond the built-in fetch+cheerio scraper). https://firecrawl.dev ---
FIRECRAWL_API_KEY=

# --- Future: outbound sequencer integration for Module 5 (feedback loop) ---
INSTANTLY_API_KEY=
HUBSPOT_API_KEY=
